# Database configuration
DB_URL=jdbc:postgresql://localhost:5432/sams_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# JWT security configuration (at least 32 characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000

# OTP HMAC pepper secret (at least 32 characters, backend-only, never committed)
OTP_HASH_SECRET=replace-with-a-random-otp-hash-secret-at-least-32-characters-long

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# SendGrid email service credentials
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=verified-sender@yourdomain.com
